{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "npm run *": "allow",
      "git *": "allow",
      "node *": "allow",
      "npm install*": "ask",
      "npm uninstall*": "ask",
      "rm *": "deny",
      "Remove-Item*": "deny",
      "del *": "deny"
    }
  }
}
