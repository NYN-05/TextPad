# TextPad server — environment variables template
# Copy to .env for local development, or set in the Render Dashboard
# (Settings → Environment). render.yaml wires the production values.

# Port (Render sets this automatically)
PORT=3001

# HMAC-SHA256 signing secret for session tokens.
# Generate with: openssl rand -hex 32
# Set a FIXED value so tokens survive restarts/deploys. If unset, a random
# secret is generated at startup and all existing tokens become invalid.
API_SECRET=change-me-to-a-long-random-string

# Comma-separated list of additional CORS origins, e.g. your Vercel frontend.
# Leave EMPTY in development — localhost origins are allowed by default.
CORS_ORIGINS=https://textpad.vercel.app

# pino log level
LOG_LEVEL=info

# Number of trusted proxy hops in front of the server (Render: 1).
# 0 disables proxy awareness (use only for direct-connection deployments).
# With 1, the client IP is read from X-Forwarded-For's last hop, which keeps
# per-IP rate limits accurate behind Render's proxy. Set 0 if running behind
# no proxy at all and spoofed headers are a concern.
TRUST_PROXY=1
